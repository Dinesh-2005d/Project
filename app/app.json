{
  "expo": {
    "name": "HealthCare Pro",
    "slug": "healthcare-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dinesh.healthcarepro",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used for patient photo capture",
        "NSLocationWhenInUseUsageDescription": "Location used for hospital navigation"
      }
    },
    "android": {
      "package": "com.dinesh.healthcarepro",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0A0E27"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "8dd58310-cb3e-430d-ba83-30bb6a1c9849"
      }
    },
    "owner": "deepanjagan"
  }
}
